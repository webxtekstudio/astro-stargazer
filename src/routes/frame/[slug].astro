---
export const prerender = false;

const { slug } = Astro.params;
const origin = Astro.url.origin;

let pathsData: any = null;
let previewData: any = null;
let darkModeConfig: any = {};

const urlObj = Astro.url;
const overrideLayout = urlObj.searchParams.get('overrideLayout') || '';
const overridePropsRaw = urlObj.searchParams.get('overrideProps') || '';
let overrideProps: Record<string, any> = {};
if (overridePropsRaw) {
  try { overrideProps = JSON.parse(decodeURIComponent(overridePropsRaw)); } catch { }
}

const runtime = (globalThis as any).__STARGAZER_RUNTIME__;
if (runtime) {
  previewData = runtime.getPreviewData(slug);
  pathsData = await runtime.getPathsData(slug, overrideLayout);
  if (pathsData?.darkMode && typeof pathsData.darkMode === 'object') {
    darkModeConfig = pathsData.darkMode;
  }
} else {
  try {
    const [pathsRes, previewRes] = await Promise.all([
      fetch(`${origin}/__stargazer/paths/${encodeURIComponent(slug!)}${overrideLayout ? `?overrideLayout=${encodeURIComponent(overrideLayout)}` : ''}`),
      fetch(`${origin}/__stargazer/preview/${encodeURIComponent(slug!)}`),
    ]);
    if (pathsRes.ok) {
      pathsData = await pathsRes.json();
      if (pathsData.darkMode && typeof pathsData.darkMode === 'object') {
        darkModeConfig = pathsData.darkMode;
      }
    }
    if (previewRes.ok) previewData = await previewRes.json();
  } catch { }
}

if (!pathsData || pathsData.error || !previewData || previewData.error) {
  return Astro.redirect('/stargazer');
}

const props = { ...(previewData.props || {}), ...overrideProps };

const cssLinks: string[] = pathsData.cssLinks || [];
const scriptLinks: string[] = pathsData.scriptLinks || [];
const inlineStyles: string[] = pathsData.inlineStyles || [];
const darkModeConfigStr = JSON.stringify(darkModeConfig);

let Component: any = null;
let Layout: any = null;
let loadError: string | null = null;

try {
  Component = (await import(/* @vite-ignore */ pathsData.compFsUrl)).default;
} catch (e: any) {
  loadError = `Failed to load component: ${e?.message || e}`;
}

if (!loadError && pathsData.layoutFsUrl) {
  try {
    Layout = (await import(/* @vite-ignore */ pathsData.layoutFsUrl)).default;
  } catch (e: any) {
    loadError = `Failed to load layout: ${e?.message || e}`;
  }
}
---

{loadError ? (
  <div style="font-family: monospace; padding: 2rem; color: #ff6b6b; background: #1a1a2e; min-height: 100vh; box-sizing: border-box;">
    <strong style="display: block; margin-bottom: 0.5rem; font-size: 1.1rem;">⚠ Preview Error</strong>
    <code style="white-space: pre-wrap; font-size: 0.85rem; opacity: 0.9;">{loadError}</code>
    <p style="margin-top: 1rem; font-size: 0.8rem; opacity: 0.6;">Fix the error above or add missing props via <code>defaults</code> in your stargazer config.</p>
  </div>
) : Layout && Component ? (
  <Layout {...props}>
    <script type="module" src="/@vite/client"></script>
    {inlineStyles.map(css => <style is:inline set:html={css} />)}
    {cssLinks.map(url => (
      url.includes('?astro&type=style') ? (
        <script type="module" src={url}></script>
      ) : (
        <link rel="stylesheet" href={url} />
      )
    ))}
    <Component {...props} />
    <script is:inline define:vars={{ darkModeConfigStr }}>
      window.__stargazerDarkMode = JSON.parse(darkModeConfigStr);
    </script>
    <script is:inline src="/__stargazer_controls.js"></script>
    {scriptLinks.map(url => <script type="module" src={url}></script>)}
  </Layout>
) : Component ? (
  <>
    <script type="module" src="/@vite/client"></script>
    {inlineStyles.map(css => <style is:inline set:html={css} />)}
    {cssLinks.map(url => (
      url.includes('?astro&type=style') ? (
        <script type="module" src={url}></script>
      ) : (
        <link rel="stylesheet" href={url} />
      )
    ))}
    <Component {...props} />
    <script is:inline define:vars={{ darkModeConfigStr }}>
      window.__stargazerDarkMode = JSON.parse(darkModeConfigStr);
    </script>
    <script is:inline src="/__stargazer_controls.js"></script>
    {scriptLinks.map(url => <script type="module" src={url}></script>)}
  </>
) : null}

<script>
  function sgReportHeight() {
    var h = Math.max(document.documentElement.scrollHeight, document.body ? document.body.scrollHeight : 0);
    if (h > 50) parent.postMessage({ type: 'sg-resize', height: h }, '*');
  }
  window.addEventListener('load', function() {
    sgReportHeight();
    setTimeout(sgReportHeight, 500);
    setTimeout(sgReportHeight, 1500);
  });
</script>
